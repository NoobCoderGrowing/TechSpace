<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>tech-space</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tech-space</name>
    <description>Demo project for Spring Boot</description>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Markdown 渲染与 HTML 消毒。两个库版本都显式钉住：
             评论正文的消毒是本站唯一的安全边界，不能让版本随传递依赖浮动。 -->
        <commonmark.version>0.30.0</commonmark.version>
        <html-sanitizer.version>20260313.1</html-sanitizer.version>
    </properties>
    <dependencies>
        <!-- ── 日志：用 Log4j2 取代默认的 Logback ───────────────────────────────
             Spring Boot 默认的日志实现是 Logback，由 spring-boot-starter-logging 带来。
             它不在下面任何一条依赖里显式出现，而是**经由 spring-boot-starter 传递**进来的。

             Maven 的 <exclusions> 只作用于「声明它的那一条依赖及其子树」，没有全局写法，
             所以要把 Logback 摘干净，就得把通往 spring-boot-starter 的每一条直接依赖
             各排一次 —— 实测正好 5 条：data-mongodb / data-redis / security / web / test。
             漏掉任何一条，Logback 和 Log4j2 就会同时躺在 classpath 上，SLF4J 只会挑
             一个绑定并打 warning，实际用哪个变得不确定（在 IDE 里和打包后还可能不一样）。

             改完这样验证，应当**一条都查不到**：
               ./mvnw dependency:tree -Dincludes=ch.qos.logback:logback-classic
             配置文件是 src/main/resources/log4j2-spring.xml，注意文件名里的 -spring：
             只有它才认 <SpringProfile>（按 profile 分环境），叫 log4j2.xml 就只是个纯
             Log4j2 配置，profile 分支会被忽略。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
<!--    session management-->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
<!--        security-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
<!--        docker compose-->
<!--        <dependency>-->
<!--            <groupId>org.springframework.boot</groupId>-->
<!--            <artifactId>spring-boot-docker-compose</artifactId>-->
<!--        </dependency>-->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Logback 被上面 5 条排掉之后，由这个 starter 补上 Log4j2：
             log4j-core + log4j-slf4j2-impl（SLF4J 2.x 的绑定）+ log4j-jul。
             版本由 spring-boot-starter-parent 管（3.1.4 → Log4j2 2.20.0），不用写。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>2.0.39</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>

        <!-- 评论正文：Markdown -> HTML。
             注意 commonmark 默认会把内联/块级 HTML **原样透传**，光有它等于开了一个
             XSS 直通车；下面的消毒器是兜底，但渲染时也要显式 escapeHtml(true)。 -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- 裸写的 URL 自动变链接，评论里贴个地址很常见 -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-autolink</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- ~~删除线~~ -> <del> -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- 白名单消毒器。任何有 GitHub 账号的人都能立刻发布评论，
             所以这一层是互联网和后台之间的唯一屏障，不要自己写正则替代。 -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <version>${html-sanitizer.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin - 版本由 parent POM 管理 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
